generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Appointment {
  id             String            @id @default(cuid())
  clientName     String
  clientEmail    String
  clientPhone    String?
  reason         String?
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(PENDING)
  adminNotes     String?
  reminderSentAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([startsAt])
  @@index([status])
}
